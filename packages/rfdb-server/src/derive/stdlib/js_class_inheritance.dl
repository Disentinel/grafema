% js_class_inheritance.dl — in-engine replacement for the ENTIRE ClassInheritance.hs
% resolver (packages/grafema-resolve/src/ClassInheritance.hs:84-159, resolveOne):
% EXTENDS edges for `class Dog extends Animal`. Wave 2 — the first node_attr pack:
% the superclass name lives ONLY in CLASS node metadata (`superClass`, recorded by
% the analyzer at Declarations.hs:320-337 — "EXTENDS edge created by shape-tracker
% plugin"; the analyzer emits NO superclass edge, which is the whole reason the
% resolver exists). node_attr(C, "superClass", SC) unblocks it.
%
% FIVE ARMS — the resolver's two-arm fall-through (resolveOne, Hs:96-129)
% plus the three Wave-2b arms:
%   A1 same-file:  superClass names a CLASS in the same file (Hs:97-105).
%   A2 cross-file: ONLY when the same-file index missed (Hs:106-108) — the
%      superclass name is an import binding in the class's file; follow the
%      binding's IMPORTS_FROM edge to the resolved export target. HYBRID seam
%      (same as js_cross_file_calls): the legacy import resolver's committed
%      IMPORTS_FROM edge replaces the resolver's own
%      resolveModulePath+findMatchingExport re-derivation (Hs:111-118) — and the
%      legacy producer already disambiguated aliased/default bindings via
%      importedName when it created the edge, so the Wave-1 localName-aliasing
%      caveat does not apply.
%   A2c chain (Wave 2b): the same import binding resolved IN-PACK through the
%      visible() re-export fixpoint (binding's parent IMPORT → MODULE seam +
%      exportedName/local-name rebinding + star RE_EXPORTS recursion — the
%      js_import_bindings.dl prelude, textual duplicate). Where the legacy
%      binding edge exists both arms derive the same collapsed endpoint
%      (additive dedup); where the legacy chain failed (depth/cycle caps) or
%      legacy is gated, this arm stands alone.
%   A3 builtin import (Wave 2b — LIVE-GRAPH-GROUNDED, see below): the
%      superclass binding's source is a Node builtin module
%      (`import { EventEmitter } from 'events'`) — no IMPORTS_FROM edge ever
%      exists for it (bare specifier: legacy import resolution skips,
%      ImportResolution.hs:207-208; legacy Builtins mints only
%      EXTERNAL_FUNCTION call targets). Resolve to the type-inference
%      builtin CLASS node: name = the binding's importedName, file
%      "<builtin>" (plugins/type-inference.mjs Phase 1 mints
%      CLASS:<Name>@<builtin> for ~21 globals incl. EventEmitter/Error before
%      the pack-runner phase — orchestrator main.rs step 8m before step 9).
%   A4 builtin global (Wave 2b): no same-file class AND no binding at all —
%      an unimported global superclass (`class E extends Error`). Resolve to
%      the type-inference CLASS:<superClass>@<builtin> node when one exists.
%
% EVIDENCE (2026-06-10 live probe of the gated fresh-DB run, EXTENDS 10 vs
% legacy-baseline 14): the four lost edges are GrafemaError→Error,
% StrictModeFailure→Error (packages/util/src/errors/GrafemaError.ts:46,:280 —
% global, unimported), GrafemaClientManager→EventEmitter
% (packages/vscode/src/grafemaClient.ts:14,158) and
% BaseRFDBClient→EventEmitter (packages/rfdb/ts/base-client.ts:8,49 — both
% `import { EventEmitter } from 'events'`). NOT re-export chains (the
% migration-synthesis claim is corrected by this probe): in the legacy
% baseline these four came from the shape-tracker plugin's global name index
% over type-inference's builtin classes, which the gated run's plugin pass
% missed. A3+A4 close them deterministically at pack time. If type-inference
% never ran, both arms derive nothing (graceful).
%
% EXTENDS is SHARED vocabulary — the shape-tracker batch plugin (Phase 3a) and
% this pack's legacy twin both emit it (packages/types/src/edges.ts:45) —
% ⇒ mode = "additive" on both heads.
%
% NUMBERED DELTAS vs the resolver (everything not listed is exact):
%   DELTA 1 (superset): duplicate same-name CLASS in one file — the resolver's
%     Map-built class index kept one arbitrary last-wins winner (Hs:53-60); set
%     semantics derives an EXTENDS edge per candidate. Same for duplicate-named
%     import bindings.
%   DELTA 2 (point-wise different, pathological only): a class whose only
%     same-file name-match is ITSELF (duplicate-named classes in nested scopes) —
%     the resolver would emit a self-edge and stop; the pack's neq(C, T) refuses
%     the self-edge. The cross-file arm is suppressed in BOTH (has_local counts C
%     itself — the resolver's fall-through gate, reproduced exactly).
%   DELTA 3 (endpoint, re-exports only): a superclass imported through a
%     re-export chain — the resolver's own lookup stopped at the FIRST-LEVEL
%     export entry (findMatchingExport, no chain following in resolveOne);
%     the legacy IMPORTS_FROM edge collapsed the chain to the final declaration
%     (ImportResolution.hs:363-407). Following the edge inherits the
%     chain-collapsed endpoint (same class as js_cross_file_calls DELTA 1).
%   DELTA 4 (superset): superclasses imported from WORKSPACE packages or through
%     star re-exports — the resolver's binding index was relative-specifier-only
%     (buildImportBindingIndex, Hs:64-73); the legacy import resolver handled
%     both, so the binding's edge exists and the pack emits.
%   DELTA 5 (not reproduced — legacy artifact): a namespace binding
%     (`import * as Base`) used directly as a superclass name — its legacy edge
%     points at a MODULE node; the `\+ node(T, "MODULE")` guard emits nothing
%     (the resolver's findMatchingExport("*") matched only star re-export
%     entries — practically nothing — so both sides are empty in practice).
%   DELTA 6 (metadata): resolvedVia="class-inheritance" projected as a meta
%     column (the resolver's stamp, Hs:103); the cross-file arm's importedFrom
%     meta (Hs:126) is DROPPED — the binding's source specifier is metadata-only
%     on the IMPORT_BINDING and not needed by any known consumer; recorded loss.
%   DELTA 7 (file gate): the resolver's OWN gate was isJsTsFile = 6 extensions
%     (Hs:76-77) — the jsts_class clause set below, one clause per extension
%     (a derived gate is planner-infeasible, see js_same_file_calls.dl ENCODING
%     NOTES).
%   DELTA 8 (Wave 2b, superset vs the RESOLVER — parity with the legacy
%     GRAPH): A3/A4 emit edges the ClassInheritance.hs resolver never could
%     (its binding index was relative-specifier-only, Hs:64-73, and it had no
%     global arm); the legacy graph carried them via shape-tracker. A3 is
%     narrower than shape-tracker's any-name-match index: the binding source
%     must be a builtin_spec module (no `import {EventEmitter} from
%     'eventemitter3'` false positive) and the match key is importedName (no
%     alias false positive). A4 fires only with NO candidate binding and NO
%     same-file class — JS global-scope semantics.
%   DELTA 9 (Wave 2b): A2c inherits the visible() chain deltas — see
%     js_import_bindings.dl DELTA 1 (bounded named-hop subset) and DELTA 1b
%     (set-semantics supersets).
%
% MAINTAIN ENVELOPE: node_attr reads metadata blobs outside the delta algebra —
% maintain-incremental refuses this pack; it runs at the scratch floor (accepted).
%
% ORDERING (producer): EXTENDS is consumed by shape_verifier's EXTENDS-closed
% member lookup — this pack MUST run before shape_verifier. Its A2 arm consumes
% IMPORTS_FROM as EDB — run after js_import_bindings (and after the legacy
% resolve phase, which the pack-runner guarantees).

% Every CLASS in a JS/TS file — the resolver's own 6-extension gate (DELTA 7).
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".ts").
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".tsx").
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".js").
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".jsx").
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".mjs").
jsts_class(C, F) :- node(C, "CLASS"), attr(C, "file", F), ends_with(F, ".cjs").

% A class with a recorded superclass name — the node_attr unblock (the analyzer
% stores superClass only when non-empty; the neq guards other producers).
super_of(C, F, SC) :- jsts_class(C, F), node_attr(C, "superClass", SC), neq(SC, "").

% Same-file class index (file, name) → node (Hs:53-60). RETAINED for the
% has_local fall-through gate ONLY (see below) — keeping it FLAT keeps the A2/
% A2c/A3/A4 cross-file/builtin arms BYTE-IDENTICAL in behaviour: those arms gate
% on `\+ has_local(C)`, so their firing condition must not move. On every real
% JS/TS graph one file is exactly one MODULE and there are no same-(file,name)
% class collisions, so flat class_in and the MODULE-scoped lookup below coincide
% (LIVE-VERIFIED on the dogfood graph: flat A1 = 8 edges ≡ MODULE-scoped A1 = 8
% edges, byte-for-byte same C→T pairs; same-(file,name) collisions = 0; nested
% classes = 0).
class_in(F, N, T) :- node(T, "CLASS"), attr(T, "file", F), attr(T, "name", N), neq(N, "").

% Same-file candidate EXISTS — the resolver's fall-through gate (Hs:97/106).
% Counts C itself (DELTA 2: gate parity over edge parity). KEPT on the FLAT
% class_in so A2-A4 stay byte-identical (see class_in note above).
has_local(C) :- super_of(C, F, SC), class_in(F, SC, T).

% ── A1 binder = LEXICAL SCOPE-WALK over CONTAINS (gold idiom: js_same_file_calls
%    B1 / js_property_access_full encl_* walk CONTAINS+HAS_SCOPE to the nearest
%    binder) ─────────────────────────────────────────────────────────────────
% A CLASS is MODULE-contained (LIVE-VERIFIED: every file-resident CLASS has
% exactly one CONTAINS parent and it is a MODULE; <builtin> classes have none).
% The binder for a same-file superclass NAME is therefore the CLASS reachable in
% the referencing class's enclosing MODULE — `[M:MODULE] -CONTAINS-> {C, T}` —
% NOT a raw (file, name) match. This disambiguates a nested class (CONTAINS
% parent ≠ MODULE) shadowing a top-level same-name superclass: such a class is
% NOT contained by the MODULE, so it cannot bind a sibling-module reference.
% (0 nested-class instances on the current corpus ⇒ measurable delta is 0; the
% rework is a soundness/precision hardening that pays off on a future graph.)
class_module(C, M) :- node(C, "CLASS"), edge(M, C, "CONTAINS"), node(M, "MODULE").

% The referencing class's enclosing-MODULE class index (binder = a CLASS sharing
% the same MODULE container, keyed by name). Replaces the FLAT (file,name)
% lookup for the A1 head only.
class_in_mod(M, N, T) :-
    edge(M, T, "CONTAINS"), node(T, "CLASS"), node(M, "MODULE"),
    attr(T, "name", N), neq(N, "").

% A1: same-file superclass, resolved by lexical scope-walk to the enclosing
% MODULE's class binder (not flat file,name). super_of stays the SC seed.
@materialize(edge_type = "EXTENDS", mode = "additive", meta(resolvedVia))
ext_same_file(C, T, "class-inheritance") :-
    super_of(C, F, SC), class_module(C, M), class_in_mod(M, SC, T), neq(C, T).

% A2: cross-file superclass through the import-binding's legacy IMPORTS_FROM
% edge (hybrid EDB seam), only when the same-file index missed. MODULE targets
% are namespace bindings, not classes (DELTA 5).
@materialize(edge_type = "EXTENDS", mode = "additive", meta(resolvedVia))
ext_cross_file(C, T, "class-inheritance") :-
    super_of(C, F, SC), \+ has_local(C),
    node(B, "IMPORT_BINDING"), attr(B, "file", F), attr(B, "name", SC),
    edge(B, T, "IMPORTS_FROM"), \+ node(T, "MODULE").

% ── Wave 2b: the re-export chain prelude (textual duplicate of
%    js_import_bindings.dl — derived relations are per-program) ─────────────
exported_in(TF, N, T) :-
    node(E, "EXPORT"), attr(E, "file", TF),
    edge(E, T, "EXPORTS"), \+ node(T, "EXPORT_BINDING"),
    attr(T, "name", N), neq(N, "").
exported_in(TF, "default", E) :-
    node(E, "EXPORT"), attr(E, "name", "default"), attr(E, "file", TF).
eb_reexport(EB) :- node(EB, "EXPORT_BINDING"), node_attr(EB, "source", S).
exported_in(TF, N, EB) :-
    node(EB, "EXPORT_BINDING"), attr(EB, "file", TF),
    \+ eb_reexport(EB),
    node_attr(EB, "exportedName", N), neq(N, "").
% Wave 4: gnExported declarations (buildExportIndex class 3, Hs:137) —
% textual duplicate of the js_import_bindings.dl arm, cost-gated by the
% chain-reachable files (sb_named is this pack's chain seed).
target_file(TF) :- sb_named(_, TF, _).
target_file(TF) :- reexp(_, _, _, TF).
target_file(TF) :- star_src(_, TF).
% One typed scan per declaration type (NOT target_file-led: a small leading
% generator turns each node() leg into per-row typed re-scans — 211 x 8 full
% scans cost ~8.5s on the dogfood copy; one materialized scan + a hash join
% against target_file is ~1s). node_attr stays AFTER the target_file join —
% the metadata parse touches only chain-reachable files' declarations.
exp_decl(D, TF, N) :- node(D, "FUNCTION"),   attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "VARIABLE"),   attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "CONSTANT"),   attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "CLASS"),      attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "INTERFACE"),  attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "TYPE_ALIAS"), attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "ENUM"),       attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exp_decl(D, TF, N) :- node(D, "NAMESPACE"),  attr(D, "file", TF), attr(D, "name", N), neq(N, "").
exported_in(TF, N, D) :-
    exp_decl(D, TF, N), target_file(TF), node_attr(D, "__exported", "true").

resolved_at(F, S, TF) :-
    node(I, "IMPORT"), attr(I, "file", F), attr(I, "name", S),
    edge(I, M, "IMPORTS_FROM"), node(M, "MODULE"), attr(M, "file", TF).
reexp(F, EN, LN, TF2) :-
    node(EB, "EXPORT_BINDING"), attr(EB, "file", F), attr(EB, "name", LN), neq(LN, ""),
    node_attr(EB, "source", S),
    node_attr(EB, "exportedName", EN), neq(EN, ""),
    resolved_at(F, S, TF2).
% Wave 4: the binding's own committed RE_EXPORTS hop edge (js_module_imports'
% eb_reexport_hop seam) — covers the seam-less named hop; textual duplicate of
% the js_import_bindings.dl arm.
reexp(F, EN, LN, TF2) :-
    node(EB, "EXPORT_BINDING"), attr(EB, "file", F), attr(EB, "name", LN), neq(LN, ""),
    node_attr(EB, "exportedName", EN), neq(EN, ""),
    edge(EB, M2, "RE_EXPORTS"), node(M2, "MODULE"), attr(M2, "file", TF2).
star_src(F, TF2) :-
    node(E, "EXPORT"), attr(E, "file", F), attr(E, "name", N), starts_with(N, "*:"),
    edge(E, M, "RE_EXPORTS"), node(M, "MODULE"), attr(M, "file", TF2).
visible(TF, N, T) :- exported_in(TF, N, T).
visible(F, EN, T) :- reexp(F, EN, LN, TF2), visible(TF2, LN, T).
visible(F, N, T)  :- star_src(F, TF2), visible(TF2, N, T).

% A2c: the superclass binding resolved in-pack through the chain — the
% binding's parent IMPORT → MODULE edge gives the target file (the
% js_import_bindings hybrid seam), visible() collapses the chain.
sb_named(C, TF, IN) :-
    super_of(C, F, SC), \+ has_local(C),
    node(B, "IMPORT_BINDING"), attr(B, "file", F), attr(B, "name", SC),
    edge(I, B, "CONTAINS"), node(I, "IMPORT"),
    edge(I, M, "IMPORTS_FROM"), node(M, "MODULE"), attr(M, "file", TF),
    node_attr(B, "importedName", IN), neq(IN, "*"), neq(IN, "").
@materialize(edge_type = "EXTENDS", mode = "additive", meta(resolvedVia))
ext_chain(C, T, "class-inheritance") :-
    sb_named(C, TF, IN), visible(TF, IN, T), neq(C, T), \+ node(T, "MODULE").

% ── Wave 2b: builtin superclasses (A3 + A4 — the live-probed EXTENDS gap) ──

% Generated ground facts: builtin module specifiers (textual duplicate of
% js_builtins_nodes.dl; the A3 gate against npm-package name collisions).
builtin_spec("fs", "fs").
builtin_spec("node:fs", "fs").
builtin_spec("fs/promises", "fs/promises").
builtin_spec("node:fs/promises", "fs/promises").
builtin_spec("path", "path").
builtin_spec("node:path", "path").
builtin_spec("http", "http").
builtin_spec("node:http", "http").
builtin_spec("https", "https").
builtin_spec("node:https", "https").
builtin_spec("crypto", "crypto").
builtin_spec("node:crypto", "crypto").
builtin_spec("child_process", "child_process").
builtin_spec("node:child_process", "child_process").
builtin_spec("url", "url").
builtin_spec("node:url", "url").
builtin_spec("util", "util").
builtin_spec("node:util", "util").
builtin_spec("os", "os").
builtin_spec("node:os", "os").
builtin_spec("events", "events").
builtin_spec("node:events", "events").
builtin_spec("stream", "stream").
builtin_spec("node:stream", "stream").
builtin_spec("buffer", "buffer").
builtin_spec("node:buffer", "buffer").
builtin_spec("worker_threads", "worker_threads").
builtin_spec("node:worker_threads", "worker_threads").

% The type-inference builtin class index (name → node) — its own helper so
% node(T, "CLASS") is the SEED GENERATOR (the class_in pattern; inlining the
% triple into A3/A4 makes node(T,…) a cross-join the planner rejects,
% E-PLAN-003, observed live 2026-06-10).
builtin_class(N, T) :-
    node(T, "CLASS"), attr(T, "file", "<builtin>"), attr(T, "name", N), neq(N, "").

% A3: superclass imported from a builtin module → the type-inference builtin
% CLASS node (name = importedName — alias-correct; DELTA 8).
@materialize(edge_type = "EXTENDS", mode = "additive", meta(resolvedVia))
ext_builtin_import(C, T, "class-inheritance") :-
    super_of(C, F, SC), \+ has_local(C),
    node(B, "IMPORT_BINDING"), attr(B, "file", F), attr(B, "name", SC),
    node_attr(B, "source", Spec), builtin_spec(Spec, _),
    node_attr(B, "importedName", IN), neq(IN, "*"), neq(IN, ""),
    builtin_class(IN, T).

% A4: unimported global superclass → the type-inference builtin CLASS node
% (fires only with NO same-file class and NO candidate binding — JS
% global-scope semantics; DELTA 8).
has_super_binding(C) :-
    super_of(C, F, SC),
    node(B, "IMPORT_BINDING"), attr(B, "file", F), attr(B, "name", SC).
@materialize(edge_type = "EXTENDS", mode = "additive", meta(resolvedVia))
ext_builtin_global(C, T, "class-inheritance") :-
    super_of(C, F, SC), \+ has_local(C), \+ has_super_binding(C),
    builtin_class(SC, T).
