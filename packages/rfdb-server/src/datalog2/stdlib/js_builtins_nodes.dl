% ── 8-extension JS gates (DELTA 4) ─────────────────────────────────────────
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".js"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".jsx"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".ts"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".tsx"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".mjs"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".cjs"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".mts"), attr(I, "name", Spec), neq(Spec, "").
js_imp(I, F, Spec) :- node(I, "IMPORT"), attr(I, "file", F), ends_with(F, ".cts"), attr(I, "name", Spec), neq(Spec, "").

js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".js").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".jsx").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".ts").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".tsx").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".mjs").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".cjs").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".mts").
js_b(B, F) :- node(B, "IMPORT_BINDING"), attr(B, "file", F), ends_with(F, ".cts").

% ── Phase 1 (Hs:294-314): EXTERNAL_MODULE per builtin-specifier IMPORT ──
imported_builtin(M) :- js_imp(_, _, Spec), builtin_spec(Spec, M).

@materialize_node(node_type = "EXTERNAL_MODULE", mode = "exclusive", meta(source))
ext_module_node(Sid, M, "<builtin>", "nodejs-builtin") :-
    imported_builtin(M),
    concat("EXTERNAL_MODULE:", M, Sid).

% ── The builtin import-binding index (Hs:262-272): (file, localName) →
%    (module, importedName). source + importedName are metadata-only ⇒ node_attr.
bi_binding(F, LN, M, IN) :-
    js_b(B, F), attr(B, "name", LN), neq(LN, ""),
    node_attr(B, "source", Spec), builtin_spec(Spec, M),
    node_attr(B, "importedName", IN).

% ── Phase 2, method-call arm (Hs:345-351): "<localName>.<rest>" — FIRST-dot
%    split (binding local names are dotless, see header). NOT registry-gated
%    (verdict fix a).
bi_method_call(C, M, FnN) :-
    bi_binding(F, LN, M, _),
    node(C, "CALL"), attr(C, "file", F), attr(C, "name", Full),
    concat(LN, ".", P), strip_prefix(Full, P, FnN), neq(FnN, "").

% ── Phase 2, direct-call arm (Hs:353-357; verdict fix b): a dotless callee
%    that IS a builtin binding's local name → the binding's importedName.
dotted(C) :- node(C, "CALL"), attr(C, "name", N), string_contains(N, ".").
bi_direct_call(C, M, IN) :-
    bi_binding(F, LN, M, IN),
    node(C, "CALL"), attr(C, "file", F), attr(C, "name", LN),
    \+ dotted(C).

% ── The minted function set + the legacy semantic-id construction ──
ext_func(M, FnN) :- bi_method_call(_, M, FnN).
ext_func(M, FnN) :- bi_direct_call(_, M, FnN).

ext_func_sid(M, FnN, Sid) :-
    ext_func(M, FnN), neq(FnN, ""),
    concat("EXTERNAL_FUNCTION:", M, S1),
    concat(S1, ".", S2),
    concat(S2, FnN, Sid).

in_registry(M, FnN) :- builtin_func_sec(M, FnN, _).
in_registry(M, FnN) :- builtin_func_pure(M, FnN, _).

% Registry hit WITH security: meta(module, security, pure) — every such row
% is pure=False in the table (Hs:79-246), hence the "false" constant.
@materialize_node(node_type = "EXTERNAL_FUNCTION", mode = "exclusive", meta(module, security, pure))
ext_func_node_sec(Sid, FnN, "<builtin>", M, Sec, "false") :-
    ext_func_sid(M, FnN, Sid), builtin_func_sec(M, FnN, Sec).

% Registry hit WITHOUT security: meta(module, pure).
@materialize_node(node_type = "EXTERNAL_FUNCTION", mode = "exclusive", meta(module, pure))
ext_func_node_pure(Sid, FnN, "<builtin>", M, P) :-
    ext_func_sid(M, FnN, Sid), builtin_func_pure(M, FnN, P).

% NON-registry function (verdict fix a — the head a registry-gated draft
% silently dropped): meta(module) only, like the legacy node (Hs:390-394
% emits security/pure only on a registry hit).
@materialize_node(node_type = "EXTERNAL_FUNCTION", mode = "exclusive", meta(module))
ext_func_node_plain(Sid, FnN, "<builtin>", M) :-
    ext_func_sid(M, FnN, Sid), \+ in_registry(M, FnN).
