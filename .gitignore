dist/
*.tsbuildinfo
target/
dist-newstyle/
.build-hash

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*

# Environment
.env
.env.local

# pnpm
.pnpm-store/

# Claude/MCP local configs
.mcp.json
.claude/*
!.claude/skills/
!.claude/agents/
.grafema/*
